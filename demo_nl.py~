## 1st nonlinear continous time system


import numpy as np
from scipy.integrate import solve_ivp
import matplotlib.pyplot as plt


plt.close('all')

## constants
k = 1  # global variable


## ODE equations  
def f(t, x):
    global k
    dxdt = x*x-2.5 #np.sin(x)
    return dxdt


options = {
    'first_step': 0.001,
    'max_step': 0.1
}


x0 = [5]  # initial condition
t0 = 0  # initial time
tf = 5  # final time


### NUMERICAL INTEGRATION
sol = solve_ivp(f, [t0, tf], x0, method='RK23', **options)
t = sol.t
x = sol.y.T  


#### VISUALIZATION
plt.figure()
plt.subplot(1, 2, 1)
plt.plot(t, x[:, 0], '-', linewidth=2)
plt.title(f'Condition initiale x[0]={x0[0]}')
plt.xlabel('t')
plt.ylabel('x')
xt = plt.gca().get_xticks()
#plt.gca().tick_params(labelsize=18)

plt.subplot(1, 2, 2)
xx = np.arange(-3.0+float(x0[0]), 3 + float(x0[0]), 0.1)

plt.plot(xx, f(0, xx))
plt.plot(xx, xx * 0)
plt.plot(x[:, 0],0*x[:, 0], '*', linewidth=2)


plt.xlabel('x')
plt.ylabel('f(x)')

plt.show()

