
import numpy as np
import matplotlib.pyplot as plt

# clear all
plt.close('all')

def logi(x, a):
    """
    Logistic map function
    """
    f = a * x * (1 - x)
    return f

X = np.arange(0, 1.01, 0.01)
prompt = 'a= ? '
a = float(input(prompt))

if (a < 0):
    raise Exception("valeur de a non admissible")

if (a > 4):
    raise Exception("valeur de a non admissible")

# a=3.57;
f = plt.figure(1)
pf1 = [42, 520, 845, 434]
pf2 = [42, 99, 840, 318]
pf3 = [898, 692, 660, 660]
# Convert MATLAB position [left, bottom, width, height] to inches for matplotlib
# MATLAB uses pixels, matplotlib uses inches, so we divide by DPI (typically 100)
dpi = 100
f.set_size_inches(pf1[2]/dpi, pf1[3]/dpi)
f.canvas.manager.window.wm_geometry("+%d+%d" % (pf1[0], pf1[1]))

pl = plt.plot(X, logi(X, a))
plt.setp(pl, linewidth=2)
plt.gca().tick_params(labelsize=28)
plt.hold = True  # This is implicit in newer matplotlib versions
pl2 = plt.plot(X, X, 'r')
plt.setp(pl2, linewidth=2)

x = 1 - 0.05
xx = x - 0.005

xk = []
xxk = []

for i in range(1, 501):  # MATLAB's 1:500 translates to range(1, 501)
    plt.gca().tick_params(labelsize=28)
    f.set_size_inches(pf1[2]/dpi, pf1[3]/dpi)
    f.canvas.manager.window.wm_geometry("+%d+%d" % (pf1[0], pf1[1]))
    
    xk.append(x)
    xxk.append(xx)
    
    xn = logi(x, a)
    xxn = logi(xx, a)
    
    plt.figure(1)
    if (i == 1):
        L = plt.plot([x, x], [0, xn], 'b-')
        plt.setp(L, linewidth=2)
    else:
        L = plt.plot([x, x], [x, xn], 'b-')
        plt.setp(L, linewidth=2)
    
    L = plt.plot([x, xn], [xn, xn], 'b-')
    plt.setp(L, linewidth=2)
    
    plt.gca().tick_params(labelsize=28)
    plt.xlabel('x(k)', fontsize=28)
    plt.ylabel('x(k+1)', fontsize=28)
    
    if (a > 1):
        plt.title('a=' + str(a) + ' ; x_{eq}=' + str(0) + ' ; x_{eq}=' + str((a-1)/a), fontsize=28)
    else:
        plt.title('a=' + str(a) + ' ; x_{eq}=' + str(0), fontsize=28)
    
    x = xn
    xx = xxn
    
    f2 = plt.figure(2)
    # Set position for figure 2
    f2.set_size_inches(pf2[2]/dpi, pf2[3]/dpi)
    try:
        f2.canvas.manager.window.wm_geometry("+%d+%d" % (pf2[0], pf2[1]))
    except:
        pass  # Some backends may not support positioning
    
    plt.clf()  # Clear figure to redraw
    pl3 = plt.plot(xk)
    
    plt.title('x(' + str(len(xk)) + ')=' + str(xk[len(xk)-1]), fontsize=28)
    plt.xlabel('k', fontsize=28)
    plt.ylabel('x(k)', fontsize=28)
    plt.gca().tick_params(labelsize=28)
    # hold on is implicit
    plt.plot(xxk, 'r-')
    plt.setp(pl3, linewidth=3)
    
    if i > 2 and a > 3.6:
        f3 = plt.figure(3)
        # Set position for figure 3
        f3.set_size_inches(pf3[2]/dpi, pf3[3]/dpi)
        try:
            f3.canvas.manager.window.wm_geometry("+%d+%d" % (pf3[0], pf3[1]))
        except:
            pass  # Some backends may not support positioning
        
        # hold on is implicit - no need to clear
        pl4 = plt.plot(xk[len(xk)-2], xk[len(xk)-1], '*')
        plt.setp(pl4, markersize=12)
        plt.xlabel('x(k-1)', fontsize=28)
        plt.ylabel('x(k+1)', fontsize=28)
        plt.gca().tick_params(labelsize=28)
    
    plt.pause(0.001)  # Small pause to update figures
    # Wait for user input to continue
    plt.waitforbuttonpress()


